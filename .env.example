# Copy this file to ".env" and fill in real values.
# NEVER commit your real .env file - it is listed in .gitignore.

# Long random secret used to sign CSRF tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-value

# 0 = debug OFF (safe default). Only set to 1 on your own machine while developing.
# The Flask debugger allows arbitrary code execution - never enable it in production.
FLASK_DEBUG=0

# Set to 1 when the site is served over HTTPS so the session cookie is only
# ever sent over encrypted connections. Must stay 0 for plain http://127.0.0.1.
SESSION_COOKIE_SECURE=0

# Minutes of inactivity before a logged-in session expires.
SESSION_LIFETIME_MINUTES=30

# Login attempts allowed per client IP (Flask-Limiter syntax).
LOGIN_RATE_LIMIT=5 per minute;20 per hour

# Where the SQLite database lives (relative paths are inside the "instance" folder).
DATABASE_PATH=secureaccess.db
